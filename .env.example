# Configuración del servidor
PROJECT_NAME="PFGP Clinical & Financial Analytics API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000
DEBUG=True

# Origen de datos (Endpoint Eklipse)
EKLIPSE_BASE_URL="https://eklipse.grupoclinicamedicos.com:8001/v1/pfgp/centralizado"
# Token sin el prefijo Bearer. Completar únicamente en el .env local del backend.
EKLIPSE_TOKEN=
HTTP_TIMEOUT_SECONDS=30.0
HTTP_VERIFY_SSL=True

# Negocio
DEFAULT_CENTRO_ID=99
DEFAULT_DIAS_MES_CONTRACTUAL=30
